# GitHub personal access token (no special scopes needed for public repos).
# Raises the rate limit from 60/hr (unauthenticated) to 5000/hr.
# Create one at: https://github.com/settings/tokens (classic token, no scopes needed for public data)
GITHUB_TOKEN=

# Voyage AI API key, for embedding chunks in ask_repo's RAG pipeline.
# Create one at: https://dashboard.voyageai.com/ (API Keys -> Create new key)
VOYAGE_API_KEY=

# Qdrant Cloud cluster URL + API key, for vector storage in ask_repo's RAG pipeline.
# Create a free cluster at: https://cloud.qdrant.io/
QDRANT_URL=
QDRANT_API_KEY=
